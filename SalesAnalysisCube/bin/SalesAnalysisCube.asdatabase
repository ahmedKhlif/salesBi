      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>/*
La commande CALCULATE contrôle l'agrégation des cellules feuilles dans le cube.
Si la commande CALCULATE est supprimée ou modifiée, les données au sein du cube sont affectées.
Vous devez modifier cette commande uniquement si vous spécifiez manuellement la façon dont le cube est agrégé.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Net Sales Without Tax]
 AS IIF(
    [Measures].[Total Sales] = 0,
    NULL,
    [Measures].[Total Sales] - [Measures].[Total Tax]
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Discount Rate]
 AS IIF(
    ([Measures].[Total Sales] + [Measures].[Total Discount]) = 0,
    NULL,
    [Measures].[Total Discount] / ([Measures].[Total Sales] + [Measures].[Total Discount])
), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Average Tax Per Sales Line]
 AS IIF(
    [Measures].[Number of Sales Lines] = 0,
    NULL,
    [Measures].[Total Tax] / [Measures].[Number of Sales Lines]
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Average Unit Price]
 AS IIF(
    [Measures].[Total Quantity Sold] = 0,
    NULL,
    [Measures].[Total Sales] / [Measures].[Total Quantity Sold]
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Average Sales Amount]
 AS IIF(
    [Measures].[Number of Sales Lines] = 0,
    NULL,
    [Measures].[Total Sales] / [Measures].[Number of Sales Lines]
), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1; </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
  </Cubes>
